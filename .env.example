# Copy to .env and adjust. Never commit real secrets.

RESUME_PARSER_ENVIRONMENT=development
RESUME_PARSER_LOG_LEVEL=INFO

# If set, all non-health endpoints require header: X-API-Key
RESUME_PARSER_API_KEY=

# Upload limits
RESUME_PARSER_MAX_UPLOAD_BYTES=10485760
RESUME_PARSER_REQUEST_TIMEOUT_SECONDS=60

# SQLite for local; Postgres URL later
RESUME_PARSER_DATABASE_URL=sqlite:///./data/resume_parser.db

# Retention of stored files/results (days)
RESUME_PARSER_RETENTION_DAYS=30

# LLM is disabled in Phase 1 (stub only)
RESUME_PARSER_LLM_ENABLED=false
RESUME_PARSER_LLM_API_KEY=
RESUME_PARSER_LLM_BASE_URL=
RESUME_PARSER_LLM_MODEL=gpt-4o-mini
